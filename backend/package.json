{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Backend API for MERN Ecommerce Application",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
